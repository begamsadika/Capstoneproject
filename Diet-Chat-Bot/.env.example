# Local Ollama service
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_WARMUP_ENABLED=true
OLLAMA_WARMUP_TIMEOUT_SECONDS=15

# Diet AI API
API_HOST=127.0.0.1
API_PORT=8001

# Optional: enable only after the sentence-transformer model is installed locally.
CHROMA_PREWARM=false

# Ollama response deadlines in seconds. Zero disables each deadline and lets
# generation continue until Ollama finishes, the connection fails, or the user
# presses Stop.
OLLAMA_REQUEST_TIMEOUT_SECONDS=0
OLLAMA_FIRST_RESPONSE_TIMEOUT_SECONDS=0
OLLAMA_STREAM_IDLE_TIMEOUT_SECONDS=0
OLLAMA_TOTAL_RESPONSE_TIMEOUT_SECONDS=0


# Gemini API
GEMINI_API_KEY=replace_with_your_private_key
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER_MODE=hybrid
GEMINI_TIMEOUT_SECONDS=10
ONLINE_FAILURE_COOLDOWN_SECONDS=60

# Offline medical RAG (local MedlinePlus / approved guideline corpus)
MEDICAL_RAG_ENABLED=true
MEDICAL_RAG_TOP_K=3
MEDICAL_RAG_MAX_CONTEXT_CHARS=7000
# Chroma cosine distance: lower is more similar. Results above this are rejected.
MEDICAL_RAG_MAX_DISTANCE=0.60

# Hybrid behavior: Gemini is tried only for requests that reach the LLM
# fallback. Deterministic bypass, KG, ChromaDB, meal planning, and logging stay local.
