# Diet AI Chat — Backend environment variables
# Copy this file to .env and fill in your values

# Ollama model to use (must be pulled locally via: ollama pull <model>)
OLLAMA_MODEL=llama3.2:3b

# Ollama server URL (default when running locally)
OLLAMA_BASE_URL=http://localhost:11434

# Port the FastAPI backend listens on
API_PORT=8001
