# Wellora Backend — environment variables
# Copy this file to .env and fill in your real values
# NEVER commit .env — it contains secrets

# JWT authentication
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQL Server database connection
# Format: mssql+pyodbc://<user>:<password>@<host>/<database>?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL=mssql+pyodbc://sa:your_password@localhost/Wellora?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# Local SQL Server in this development setup does not support encrypted ODBC
# negotiation. Set to yes in environments configured with SQL Server TLS.
DATABASE_ENCRYPT=no

# Bounded connection pool for concurrent dashboard and chat requests.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5

# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Internal Diet Chat service. Keep this service private; browsers use the
# authenticated /api/diet-chat/stream endpoint on the main backend.
DIET_CHAT_SERVICE_URL=http://127.0.0.1:8001

# LLM-based memory summarization uses the same Ollama model as live chat.
# Keep it off for CPU-only development machines so background work cannot
# delay or time out user responses. Recent conversation messages are still
# included in every request. Enable only when the model has enough capacity.
DIET_CHAT_MEMORY_SUMMARY_ENABLED=false

# Maximum seconds without data from Diet AI. Zero means wait indefinitely;
# users can still cancel a request with the chat Stop button.
DIET_CHAT_STREAM_READ_TIMEOUT_SECONDS=0
